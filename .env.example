# ArthaVani configuration

# LLM / STT
GROQ_API_KEY=
GROQ_MODEL=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Groww (optional)
GROWW_API_KEY=
GROWW_API_SECRET=


# Local PostgreSQL persistence
DATABASE_URL=postgresql://arthavani:arthavani@localhost:5432/arthavani
CONVERSATION_USER_ID=default-user
CONVERSATION_ID=default

# Existing variables: DATABASE_URL, GROQ_API_KEY, GROQ_MODEL, DEEPGRAM_API_KEY, etc.

# FastAPI authentication
API_JWT_SECRET_KEY=generate-a-long-random-secret
API_JWT_ALGORITHM=HS256
API_JWT_EXPIRE_MINUTES=60
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Encrypt stored Groww credentials at rest.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GROWW_CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-key

