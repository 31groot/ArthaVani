  {
    "id": "AG-13",
    "query": "Are my portfolio prices real-time from Groww?",
    "expected_tools": [
      "get_portfolio_summary"
    ],
    "tool_match": "sequence",
    "grounding": {
      "tool": "get_portfolio_summary",
      "checks": [
        {
          "type": "boolean_text",
          "path": "market_data_realtime",
          "expected": false
        },
        {
          "type": "text_path_any",
          "path": "price_source",
          "values": [
            "yahoo_fallback",
            "mixed",
            "unavailable"
          ]
        },
        {
          "type": "text_contains_any",
          "values": [
            "not real-time",
            "not realtime",
            "not live",
            "delayed",
            "fallback",
            "delayed or unknown"
          ]
        }
      ]
    }
  },
