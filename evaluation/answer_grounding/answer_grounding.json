  {
    "id": "AG-08",
    "query": "How is my DATAPATTNS holding performing?",
    "expected_tools": [
      "get_portfolio_summary"
    ],
    "tool_match": "sequence",
    "grounding": {
      "tool": "get_portfolio_summary",
      "checks": [
        {
          "type": "list_number",
          "path": "holdings",
          "match": {
            "trading_symbol": "DATAPATTNS"
          },
          "value_path": "profit_loss",
          "label": "DATAPATTNS P&L amount",
          "tolerance": 1.0
        },
        {
          "type": "list_number",
          "path": "holdings",
          "match": {
            "trading_symbol": "DATAPATTNS"
          },
          "value_path": "profit_loss_percentage",
          "label": "DATAPATTNS P&L percentage",
          "tolerance": 0.1
        },
        {
          "type": "text_contains",
          "values": [
            "datapattns"
          ]
        }
      ]
    },
    "grounding_note": "For a performance question, require the holding name plus the current P&L amount and/or percentage; do not require optional current/average price context. Percentage tolerance is 0.10 percentage points to allow normal voice rounding."
  },
