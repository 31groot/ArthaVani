  {
    "id": "AG-03",
    "query": "What is my total profit or loss?",
    "expected_tools": [
      "get_portfolio_summary"
    ],
    "tool_match": "sequence",
    "grounding": {
      "tool": "get_portfolio_summary",
      "checks": [
        {
          "type": "number_path",
          "path": "profit_loss",
          "label": "total profit or loss",
          "tolerance": 0.01
        },
        {
          "type": "sentiment",
          "path": "profit_loss",
          "negative_words": [
