[
  {
    "id": "AG-01",
    "query": "How much have I invested?",
    "expected_tools": [
      "get_portfolio_summary"
    ],
    "tool_match": "sequence",
    "grounding": {
      "tool": "get_portfolio_summary",
      "checks": [
        {
          "type": "number_path",
          "path": "invested_value",
          "label": "invested value",
          "tolerance": 0.01
        }
      ]
    }
  },
