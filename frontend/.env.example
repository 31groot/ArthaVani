VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional in production when the WebSocket endpoint is on a different origin.
# Example: wss://api.example.com
VITE_VOICE_WS_URL=

# "off" disables the browser echo canceller so only the server-side WebRTC AEC runs.
# Leave unset for the safer cascade (browser AEC + server AEC).
VITE_BROWSER_AEC=
